# Dev overrides. Production uses the systemd EnvironmentFile.
BIND_ADDR=127.0.0.1:3000
STATIC_DIR=dist
DATABASE_URL=sqlite://data/cion.db
REGISTRATION_MODE=invite
COOKIE_SECURE=false
RUST_LOG=info

# Dev-сборка по умолчанию разрешает Origin localhost/127.0.0.1 на портах 1420 и 3000.
# В проде задайте внешний origin (и при необходимости дополнительные):
# PUBLIC_ORIGIN=https://reader.example.com
# ALLOWED_ORIGINS=https://reader.example.com

# X-Forwarded-For принимается только от этих прокси (Caddy на loopback):
# TRUSTED_PROXIES=127.0.0.1,::1

# Одноразовый bootstrap администратора: срабатывает только при пустой таблице users.
# После первого старта переменные уберите.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-please
